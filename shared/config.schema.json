{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "onecx-guardrail config (.guardrailrc.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFunctionLines": { "type": "integer", "minimum": 1 },
        "maxTestFunctionLines": { "type": "integer", "minimum": 1 },
        "maxFileLines": { "type": "integer", "minimum": 1 },
        "maxCyclomatic": { "type": "integer", "minimum": 1 },
        "maxCognitive": { "type": "integer", "minimum": 1 },
        "maxNesting": { "type": "integer", "minimum": 1 },
        "maxSwitchCases": { "type": "integer", "minimum": 1 },
        "maxParameters": { "type": "integer", "minimum": 1 },
        "maxConstructorParameters": { "type": "integer", "minimum": 1 },
        "maxFanOut": { "type": "integer", "minimum": 1 },
        "jscpdMinLines": { "type": "integer", "minimum": 1 },
        "jscpdMinTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "suppressionPatterns": { "type": "array", "items": { "type": "string" } },
    "include": { "type": "array", "items": { "type": "string" } },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "testFilePatterns": { "type": "array", "items": { "type": "string" } }
  }
}
